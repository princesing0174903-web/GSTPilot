DATABASE_URL=file:/home/z/my-project/db/custom.db

# ═══════════════════════════════════════════════════════════════════════════════
# Zoho Books OAuth 2.0 Integration
# ═══════════════════════════════════════════════════════════════════════════════
# Register a self-client at https://api-console.zoho.in (India data center)
# → "Server-based Applications" → copy the Client ID + Client Secret.
# Add the authorized redirect URI:
#   http://localhost:3000/api/integrations/zoho/callback  (dev)
#   https://<your-domain>/api/integrations/zoho/callback  (prod)
# Scope to grant: ZohoBooks.fullaccess.all
#
# ZOHO_DC controls which Zoho data center is used:
#   in  → accounts.zoho.in  + www.zohoapis.in  (India — default)
#   com → accounts.zoho.com + www.zohoapis.com (US)
#   eu  → accounts.zoho.eu  + www.zohoapis.eu  (Europe)
#   au  → accounts.zoho.com.au + www.zohoapis.com.au (Australia)
#   jp  → accounts.zoho.jp  + www.zohoapis.jp  (Japan)
#   ca  → accounts.zoho.ca  + www.zohoapis.ca  (Canada)
# ═══════════════════════════════════════════════════════════════════════════════
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3000/api/integrations/zoho/callback
