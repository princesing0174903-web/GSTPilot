# ═══════════════════════════════════════════════════════════════════════════════
# GSTPilot — Setu AA Sandbox Credentials
#
# Copy these lines into your .env file (or set them in the server environment)
# after generating the OAuth key in Setu Bridge → Org settings → API keys.
#
# DO NOT commit real secrets to Git. The .env file is gitignored.
# ═══════════════════════════════════════════════════════════════════════════════

# Switch the banking provider from Mock to Setu AA.
BANK_PROVIDER=setu

# Setu sandbox OAuth credentials (from Bridge → Org settings → API keys → OAuth → Generate key).
# Select "Sandbox" environment when generating the key.
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=

# The Product Instance ID from your product config (Step 1 of the AA Data product).
# This is the ID you already have:
SETU_PRODUCT_INSTANCE_ID=66168f7c-f3f5-4d4d-860f-921ced28abb9

# Setu sandbox API endpoints.
# BASE_URL: the FIU base URL for consent/session/data calls.
# AUTH_URL: the OAuth2 token endpoint.
# (Confirm exact values from your Bridge → API keys page after key generation.)
SETU_BASE_URL=https://aa-sandbox.setu.co
SETU_AUTH_URL=https://baseref.setu.co/token

# Webhook HMAC secret — YOU choose this value. Set the SAME string in:
#   1. This file (SETU_WEBHOOK_SECRET)
#   2. Setu Bridge → your product → Step 1 → Notification endpoint config
# The webhook route uses it to verify the x-setu-signature header.
SETU_WEBHOOK_SECRET=

# The redirect URL Setu sends the user to after consent approval.
# This is the GSTPilot consent return page (verified HTTP 200).
SETU_REDIRECT_URL=https://preview-chat-79916a4d-1449-42eb-9867-d92b791821a4.space-z.ai/banking/consent/return

# The public app URL (used as a fallback for SETU_REDIRECT_URL if not set).
NEXT_PUBLIC_APP_URL=https://preview-chat-79916a4d-1449-42eb-9867-d92b791821a4.space-z.ai

# Webhook URL (for reference — Setu already has this saved in Step 1):
# https://preview-chat-79916a4d-1449-42eb-9867-d92b791821a4.space-z.ai/api/webhooks/setu
