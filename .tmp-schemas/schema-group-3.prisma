  error                  String?
  errorMessage           String?
  log                    String?  // JSON SyncLogEntry[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // TODO: relation to BusinessConnection (connectionId) — defined in another group
  installedIntegration   InstalledIntegration? @relation(fields: [installedIntegrationId], references: [id])
}

// ─── GROUP 3.34 — SyncLog (one connection sync log entry) ────────────────────
model SyncLog {
  id              String   @id @default(cuid())
  connectionId    String
  status          String   @default("syncing") // syncing | success | partial | failed
  recordsImported Int      @default(0)
  errorsCount     Int      @default(0)
  message         String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // TODO: relation to BusinessConnection (connectionId) — defined in another group
}

// ─── GROUP 3.35 — SyncQueueItem (rate-limited queue for auto-sync) ───────────
model SyncQueueItem {
  id            String   @id @default(cuid())
  connectionId  String
  status        String   @default("queued") // queued | running | done | failed
  trigger       String   @default("manual") // manual | scheduled | webhook | dependency
  priority      Int      @default(5)
  attempts      Int      @default(0)
  maxAttempts   Int      @default(3)
  scheduledAt   DateTime @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // TODO: relation to BusinessConnection (connectionId) — defined in another group
}

// ─── GROUP 3.36 — TaskEdge (execution-task dependency edge) ───────────────────
model TaskEdge {
  id         String   @id @default(cuid())
  fromJobId  String
  toJobId    String
  relation   String   // depends_on | spawned_from | triggered_by | chained_to
  metadata   String?  // JSON object
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // TODO: relation to ExecutionJob / ExecutionTask — defined in another group
}

// ─── GROUP 3.37 — TaxRule (per-country tax rule) ─────────────────────────────
model TaxRule {
  id                String   @id @default(cuid())
  countryIso        String
  taxType           String   // gst | vat | income_tax | corporate_tax | payroll_tax | customs | tds
  taxName           String
  ratePct           Float    @default(0)
  reducedRatePct    Float    @default(0)
  thresholdAmount   Float    @default(0)
  filingFrequency   String   @default("monthly") // monthly | quarterly | yearly
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  notes             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([countryIso, taxType, taxName])
}

// ─── GROUP 3.38 — Tenant (platform tenant / workspace owner) ──────────────────
model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String?  @unique
  plan            String   @default("free") // free | starter | pro | enterprise
  status          String   @default("trial") // trial | active | suspended | cancelled
  region          String?
  timezone        String?
  currency        String   @default("INR")
  ownerId         String?
  trialEndsAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // TODO: back-relations for Organization, Integration, Subscription,
  //       TenantMember, ApiKey, SecurityEvent, UsageEvent, Workspace, OrgModule,
  //       Policy, etc. — defined in another group
}

// ─── GROUP 3.39 — UsageEvent (per-metric daily usage counter) ─────────────────
model UsageEvent {
  id         String   @id @default(cuid())
  tenantId   String
  metric     String   // ai_requests | api_calls | automation_runs | invoices | gst_filings | bank_txns | emails | whatsapp | reports | exports
  count      Int      @default(0)
  bucket     String   // YYYY-MM-DD date bucket
  metadata   String?  // JSON object
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // TODO: relation to Tenant (tenantId) — defined in another group
}

// ─── GROUP 3.40 — UserPreference (per-user UI/notification preferences) ───────
model UserPreference {
  id                  String   @id @default(cuid())
  userEmail           String   @unique
  theme               String?
  reportFormat        String?
  reminderFrequency   String?
  communicationMethod String?
  notifications       String?  // JSON { email, whatsapp, push }
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ─── GROUP 3.41 — UserProfile (per-user profile data) ─────────────────────────
model UserProfile {
  id                 String   @id @default(cuid())
  userEmail          String   @unique
  name               String?
  role               String?
  designation        String?
  firmName           String?
  industry           String?
  city               String?
  timezone           String?
  preferredLanguage  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── GROUP 3.42 — ValidationRecord (data-quality validation issue) ────────────
model ValidationRecord {
  id           String   @id @default(cuid())
  connectionId String
  entityType   String
  entityId     String?
  ruleId       String
  severity     String   @default("warning") // info | warning | error
  message      String
  payload      String?  // JSON object
  status       String   @default("open") // open | resolved | ignored
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // TODO: relation to BusinessConnection (connectionId) — defined in another group
}

// ─── GROUP 3.43 — Vendor (supplier master record) ────────────────────────────
model Vendor {
  id           String   @id @default(cuid())
  name         String
  gstin        String?  @unique
  pan          String?
  category     String?
  state        String?
  stateCode    String?
  status       String   @default("active") // active | inactive | blacklisted
  totalBilled  Float    @default(0)
  outstanding  Float    @default(0)
  metadata     String?  // JSON object
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── GROUP 3.44 — Workspace (tenant dashboard workspace layout) ───────────────
model Workspace {
  id          String   @id @default(cuid())
  tenantId    String
  key         String
  name        String
  description String?
  widgets     String   @default("[]") // JSON object[]
  savedViews  String   @default("[]") // JSON object[]
  shortcuts   String   @default("[]") // JSON object[]
  filters     String   @default("{}") // JSON object
  permissions String   @default("{}") // JSON object
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // TODO: relation to Tenant (tenantId) — defined in another group

  @@unique([tenantId, key])
}
