generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  role          String   @default("staff")
  firmId        String?
  avatar        String?
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  firm           Firm?           @relation(fields: [firmId], references: [id])
  notifications  Notification[]
  uploadedFiles  UploadedFile[]
  auditLogs      AuditLog[]
}

model Client {
  id             String   @id @default(cuid())
  gstin          String   @unique
  tradeName      String
  legalName      String?
  address        String?
  state          String?
  stateCode      String?
  contactEmail   String?
  contactPhone   String?
  entityType     String   @default("regular")
  returnPeriod   String?
  lastFilingDate String?
  status         String   @default("active")
  healthScore    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  firm                Firm?               @relation(fields: [firmId], references: [id])
  firmId              String?
  invoices            Invoice[]
  gstrFilings         GSTRFiling[]
  healthScores        HealthScore[]
  issues              Issue[]
  auditLogs           AuditLog[]
  notices             Notice[]
  documents           Document[]
  riskScores          RiskScore[]
  complianceForecasts ComplianceForecast[]
  clientInsights      ClientInsight[]
  benchmarks          ClientBenchmark[]
  uploadedFiles       UploadedFile[]
  notifications       Notification[]
  filingHistories     FilingHistory[]
  // ── Invoice Cloud™ back-relations (Phase 8 Step 3) ──
  purchaseBills       PurchaseBill[]
  expenses            Expense[]
  payments            Payment[]
  employees           Employee[]
  tdsRecords          TDSRecord[]
  // ── Communication Cloud™ back-relations (Phase 8 Step 4) ──
  whatsappMessages    WhatsAppMessage[]
  emailMessages       EmailMessage[]
  smsMessages         SMSMessage[]
  communicationLogs   CommunicationLog[]
}

model Invoice {
  id            String   @id @default(cuid())
  clientId      String
  invoiceNumber String
  invoiceDate   String
  sellerGstin   String
  buyerGstin    String?
  buyerName     String?
  invoiceType   String   @default("B2B")
  gstr1Section  String   @default("b2b")
  taxableValue  Float    @default(0)
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  igst          Float    @default(0)
  cess          Float    @default(0)
  totalAmount   Float    @default(0)
  hsnCode       String?
  reverseCharge Boolean  @default(false)
  status        String   @default("draft")
  matchStatus   String   @default("unmatched")
  riskLevel     String   @default("low")
  riskScore     Int      @default(0)
  aiExplanation String?
  notes         String?
  period        String?
  assignedTo    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Invoice Cloud™ financial fields (Phase 8 Step 3) ──
  dueDate         String?            // payment due date (ISO date string)
  gstAmount       Float    @default(0)  // denormalised tax total (cgst+sgst+igst+cess)
  paidAmount      Float    @default(0)  // amount already collected
  balanceAmount   Float    @default(0)  // totalAmount - paidAmount
  paymentStatus   String   @default("unpaid") // unpaid | partial | paid | overdue
  paymentMode     String?             // upi | bank | cash | cheque
  paymentDate     String?             // when fully paid
  recurring       Boolean  @default(false)
  recurringCycle  String?             // monthly | quarterly | yearly
  notesFinance    String?             // Invoice Cloud private notes
  sentToCustomer  Boolean  @default(false)
  sentAt          DateTime?

  client          Client                 @relation(fields: [clientId], references: [id])
  reconciliations ReconciliationResult[]
  issues          Issue[]
  items           InvoiceItem[]
}

model GSTRFiling {
  id                   String   @id @default(cuid())
  clientId             String
  returnType           String   @default("GSTR-1")
  period               String
  financialYear        String?
  status               String   @default("draft")
  filedDate            String?
  acknowledgmentNumber String?
  totalInvoices        Int      @default(0)
  readyForFiling       Int      @default(0)
  issuesFound          Int      @default(0)
  criticalErrors       Int      @default(0)
  warnings             Int      @default(0)
  totalTaxableValue    Float    @default(0)
  totalTax             Float    @default(0)
  jsonPayload          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  client Client        @relation(fields: [clientId], references: [id])
  events FilingEvent[]
  issues Issue[]
}

model ReconciliationResult {
  id               String   @id @default(cuid())
  clientId         String
  invoiceId        String
  sourceType       String   @default("books")
  sourceA          String?  @default("Purchase Register")
  sourceB          String?  @default("GSTR-2B")
  sourceGstin      String?
  matchedGstin     String?
  matchStatus      String   @default("unmatched")
  matchScore       Float    @default(0)
  mismatches       String?
  aiExplanation    String?
  aiRecommendation String?
  confidenceScore  Float    @default(0)
  workflowStatus   String   @default("pending")
  resolved         Boolean  @default(false)
  resolvedBy       String?
  resolvedAt       String?
  riskLevel        String   @default("low")
  runId            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoice Invoice            @relation(fields: [invoiceId], references: [id])
  run     ReconciliationRun? @relation(fields: [runId], references: [id])
}

model ReconciliationRun {
  id             String   @id @default(cuid())
  clientId       String
  period         String
  sources        String   @default("Purchase Register,GSTR-2B")
  totalRecords   Int      @default(0)
  matched        Int      @default(0)
  unmatched      Int      @default(0)
  partialMatches Int      @default(0)
  highRisk       Int      @default(0)
  gstDifference  Float    @default(0)
  status         String   @default("completed")
  runBy          String?
  createdAt      DateTime @default(now())

  results ReconciliationResult[]
}

model FilingEvent {
  id          String   @id @default(cuid())
  filingId    String
  clientId    String
  eventType   String
  description String?
  userId      String?
  timestamp   DateTime @default(now())

  filing GSTRFiling @relation(fields: [filingId], references: [id])
}

model Issue {
  id          String   @id @default(cuid())
  clientId    String
  invoiceId   String?
  filingId    String?
  severity    String   @default("info")
  category    String
  title       String
  description String?
  status      String   @default("open")
  assignedTo  String?
  notes       String?
  resolvedAt  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client  Client      @relation(fields: [clientId], references: [id])
  invoice Invoice?    @relation(fields: [invoiceId], references: [id])
  filing  GSTRFiling? @relation(fields: [filingId], references: [id])
}

model HealthScore {
  id                String   @id @default(cuid())
  clientId          String
  score             Int      @default(0)
  missingGstin      Int      @default(0)
  invalidGstin      Int      @default(0)
  duplicateInvoices Int      @default(0)
  filingDelays      Int      @default(0)
  validationErrors  Int      @default(0)
  period            String?
  createdAt         DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  clientId  String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  oldValue  String?
  newValue  String?
  details   String?
  timestamp DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
}

// ─── CA Firm Operations Layer ───

model TeamMember {
  id         String   @id @default(cuid())
  userId     String?  @unique
  name       String
  email      String   @unique
  role       String   @default("staff")
  department String?  @default("general")
  avatar     String?
  isActive   Boolean  @default(true)
  joinedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  performances TeamPerformance[]
  assignments  WorkloadAssignment[]
  notices      Notice[]
}

model TeamPerformance {
  id                 String   @id @default(cuid())
  teamMemberId       String
  period             String
  invoicesProcessed  Int      @default(0)
  reviewsCompleted   Int      @default(0)
  approvalsCompleted Int      @default(0)
  averageAccuracy    Float    @default(0)
  averageTurnaround  Float    @default(0)
  totalActions       Int      @default(0)
  score              Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id])
}

model WorkloadAssignment {
  id           String    @id @default(cuid())
  teamMemberId String
  entityType   String    @default("invoice")
  entityId     String?
  clientId     String?
  title        String
  description  String?
  status       String    @default("pending")
  priority     String    @default("medium")
  dueDate      String?
  assignedBy   String?
  assignedAt   DateTime  @default(now())
  completedAt  DateTime?
  notes        String?

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id])
}

model Notice {
  id           String   @id @default(cuid())
  clientId     String
  noticeType   String   @default("gst_notice")
  noticeNumber String?
  noticeDate   String?
  subject      String
  description  String?
  status       String   @default("open")
  assignedTo   String?
  priority     String   @default("medium")
  dueDate      String?
  responseDate String?
  resolution   String?
  attachments  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client   Client      @relation(fields: [clientId], references: [id])
  assignee TeamMember? @relation(fields: [assignedTo], references: [id])
}

model Document {
  id          String   @id @default(cuid())
  clientId    String?
  folder      String   @default("general")
  name        String
  fileType    String   @default("pdf")
  size        Int      @default(0)
  path        String?
  tags        String?
  description String?
  uploadedBy  String?
  version     Int      @default(1)
  isLatest    Boolean  @default(true)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client   Client?    @relation(fields: [clientId], references: [id])
  parent   Document?  @relation("DocumentVersion", fields: [parentId], references: [id])
  versions Document[] @relation("DocumentVersion")
}

model AutomationRule {
  id          String    @id @default(cuid())
  name        String
  description String?
  trigger     String
  conditions  String?
  actions     String
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  runCount    Int       @default(0)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs AutomationLog[]
}

model AutomationLog {
  id         String   @id @default(cuid())
  ruleId     String
  trigger    String
  status     String   @default("success")
  details    String?
  executedAt DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id])
}

model FirmSettings {
  id            String   @id @default(cuid())
  firmId        String?  @unique
  firmName      String   @default("GSTPilot Firm")
  logoUrl       String?
  primaryColor  String   @default("#059669")
  accentColor   String   @default("#7c3aed")
  customDomain  String?
  emailFromName String?
  emailTemplate String?
  // Free-form JSON blob for extended firm-profile / GST-config / notification
  // settings that don't warrant their own columns (legalName, state, entityType,
  // caRegNumber, officeAddress, gstConfig, notifications, etc.).
  settingsJson  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  firm Firm? @relation(fields: [firmId], references: [id])
}

model FirmMetrics {
  id                String   @id @default(cuid())
  period            String   @unique
  totalRevenue      Float    @default(0)
  mrr               Float    @default(0)
  arr               Float    @default(0)
  clientsOnboarded  Int      @default(0)
  activeClients     Int      @default(0)
  inactiveClients   Int      @default(0)
  teamUtilization   Float    @default(0)
  avgProcessingTime Float    @default(0)
  avgFilingTime     Float    @default(0)
  gstProcessed      Float    @default(0)
  profitability     Float    @default(0)
  clientGrowth      Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── AI Tax Intelligence Layer ───

model AIPrediction {
  id             String   @id @default(cuid())
  category       String   @default("revenue")
  period         String
  predictedValue Float    @default(0)
  confidence     Float    @default(0)
  lowerBound     Float    @default(0)
  upperBound     Float    @default(0)
  trend          String   @default("stable")
  modelVersion   String   @default("v1")
  factors        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RiskScore {
  id              String   @id @default(cuid())
  clientId        String
  overallScore    Int      @default(0)
  category        String   @default("overall")
  lateFilings     Int      @default(0)
  noticeFrequency Int      @default(0)
  gstMismatches   Int      @default(0)
  vendorRisk      Float    @default(0)
  itcRisk         Float    @default(0)
  riskLevel       String   @default("low")
  period          String
  factors         String?
  recommendations String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
}

model ComplianceForecast {
  id                String   @id @default(cuid())
  clientId          String?
  forecastType      String   @default("notice")
  predictedEvent    String
  probability       Float    @default(0)
  confidence        Float    @default(0)
  expectedDate      String?
  impact            String   @default("medium")
  mitigatingActions String?
  period            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

model ClientInsight {
  id          String   @id @default(cuid())
  clientId    String
  category    String   @default("compliance")
  trend       String   @default("stable")
  observation String
  confidence  Float    @default(0)
  dataPoints  String?
  period      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
}

model AITask {
  id           String    @id @default(cuid())
  clientId     String?
  source       String    @default("ai")
  sourceType   String    @default("notice")
  sourceId     String?
  title        String
  description  String?
  priority     String    @default("medium")
  status       String    @default("pending")
  assignedTo   String?
  dueDate      String?
  autoAssigned Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model KnowledgeEntry {
  id              String   @id @default(cuid())
  title           String
  category        String   @default("rule")
  content         String
  summary         String?
  tags            String?
  source          String?
  effectiveDate   String?
  referenceNumber String?
  relevanceScore  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DocumentChatSession {
  id         String   @id @default(cuid())
  documentId String?
  fileName   String?
  fileType   String?
  messages   String   @default("[]")
  summary    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ExecutiveReport {
  id          String   @id @default(cuid())
  reportType  String   @default("client_health")
  title       String
  description String?
  period      String
  data        String?
  format      String   @default("pdf")
  status      String   @default("generated")
  generatedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClientBenchmark {
  id                 String   @id @default(cuid())
  clientId           String
  metric             String
  clientValue        Float    @default(0)
  industryAverage    Float    @default(0)
  stateAverage       Float    @default(0)
  firmAverage        Float    @default(0)
  industryPercentile Float    @default(0)
  statePercentile    Float    @default(0)
  firmPercentile     Float    @default(0)
  period             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════════════
// PRODUCTION MODELS — Real Data Architecture
// ═══════════════════════════════════════════════════════════════════════════════

// ─── CA Firm ────────────────────────────────────────────────────────────────────
model Firm {
  id              String   @id @default(cuid())
  name            String
  gstin           String?  @unique
  pan             String?
  address         String?
  state           String?
  stateCode       String?
  contactEmail    String?
  contactPhone    String?
  website         String?
  logoUrl         String?
  subscriptionPlan String  @default("free")
  maxClients      Int      @default(50)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users          User[]
  clients        Client[]
  firmSettings   FirmSettings[]
}

// ─── Invoice Line Items ─────────────────────────────────────────────────────────
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  lineNumber  Int      @default(1)
  description String?
  hsnCode     String?
  quantity    Float    @default(1)
  unit        String?  @default("NOS")
  unitPrice   Float    @default(0)
  taxableValue Float   @default(0)
  cgstRate    Float    @default(0)
  sgstRate    Float    @default(0)
  igstRate    Float    @default(0)
  cessRate    Float    @default(0)
  cgst        Float    @default(0)
  sgst        Float    @default(0)
  igst        Float    @default(0)
  cess        Float    @default(0)
  totalAmount Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

// ─── Uploaded Files (Processing Pipeline) ────────────────────────────────────────
model UploadedFile {
  id              String   @id @default(cuid())
  clientId        String?
  uploadedBy      String?
  originalName    String
  storedName      String?
  fileType        String   @default("pdf")
  fileSize        Int      @default(0)
  mimeType        String?
  filePath        String?
  status          String   @default("uploaded")
  processingStep  String   @default("upload")
  progress        Int      @default(0)
  extractedData   String?
  errorMessage    String?
  invoicesCreated Int      @default(0)
  errorsCount     Int      @default(0)
  warningsCount   Int      @default(0)
  period          String?
  tags            String?
  metadata        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client   Client?  @relation(fields: [clientId], references: [id])
  uploader User?    @relation(fields: [uploadedBy], references: [id])
}

// ─── Notifications (Database-driven) ─────────────────────────────────────────────
model Notification {
  id          String    @id @default(cuid())
  userId      String?
  clientId    String?
  type        String    @default("info")
  category    String    @default("general")
  title       String
  message     String
  actionUrl   String?
  isRead      Boolean   @default(false)
  priority    String    @default("medium")
  dismissed   Boolean   @default(false)
  scheduledAt DateTime?
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User?   @relation(fields: [userId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])
}

// ─── Filing History (Status Change Tracking) ─────────────────────────────────────
model FilingHistory {
  id                 String   @id @default(cuid())
  filingId           String
  clientId           String
  previousStatus     String?
  newStatus          String
  changedBy          String?
  reason             String?
  acknowledgmentNumber String?
  notes              String?
  createdAt          DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

// ─── AI Jobs (Background Processing) ─────────────────────────────────────────────
model AIJob {
  id            String    @id @default(cuid())
  clientId      String?
  type          String    @default("ocr")
  status        String    @default("pending")
  progress      Int       @default(0)
  inputPayload  String?
  outputPayload String?
  errorMessage  String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// GSTPILOT REAL INVOICE ENGINE™ — Phase 8 Step 3
// Create. Track. Collect. Automate. — The Financial Brain of India™
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Purchase Bills (Vendor Invoices) ────────────────────────────────────────────
model PurchaseBill {
  id            String   @id @default(cuid())
  clientId      String?                       // owning business/client
  vendorName    String
  vendorGstin   String?
  invoiceNo     String                         // vendor's invoice number
  invoiceDate   String
  dueDate       String?
  taxableValue  Float    @default(0)
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  igst          Float    @default(0)
  cess          Float    @default(0)
  gstAmount     Float    @default(0)           // denormalised tax total
  totalAmount   Float    @default(0)
  paidAmount    Float    @default(0)
  balanceAmount Float    @default(0)
  status        String   @default("recorded")  // recorded | matched | paid | partial | overdue
  paymentStatus String   @default("unpaid")
  category      String?                        // procurement category
  hsnCode       String?
  notes         String?
  ocrExtracted  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

// ─── Expenses (Receipts / Operational Spend) ─────────────────────────────────────
model Expense {
  id            String   @id @default(cuid())
  clientId      String?
  category      String   @default("Miscellaneous") // Office|Travel|Salary|Marketing|Rent|Utilities|Software|Miscellaneous
  description   String?
  vendor        String?
  amount        Float    @default(0)              // total amount paid
  gst           Float    @default(0)              // GST portion (claimable)
  gstClaimable  Boolean  @default(true)
  date          String                            // expense date (ISO)
  paymentMode   String?                           // upi|bank|cash|cheque|card
  status        String   @default("recorded")     // recorded | reimbursed | claimed
  receiptUrl    String?
  ocrExtracted  Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

// ─── Payments (Customer + Vendor Settlements) ────────────────────────────────────
model Payment {
  id            String   @id @default(cuid())
  clientId      String?
  invoiceId     String?                          // links to Invoice (sales collection)
  purchaseBillId String?                         // links to PurchaseBill (vendor payment)
  partyName     String                           // customer or vendor name
  partyType     String   @default("customer")    // customer | vendor
  amount        Float    @default(0)
  paymentDate   String
  paymentMode   String   @default("upi")         // upi|bank|cash|cheque|card
  referenceNo   String?                          // UTR / cheque no
  status        String   @default("completed")   // completed | pending | failed | reconciled
  reconciled    Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

// ─── Employees (Payroll Roster) ──────────────────────────────────────────────────
model Employee {
  id            String   @id @default(cuid())
  clientId      String?
  name          String
  designation   String?
  department    String?
  employeeId    String?                          // internal emp code
  pan           String?
  aadhaar       String?
  bankAccount   String?
  ifsc          String?
  salary        Float    @default(0)             // gross monthly salary
  basic         Float    @default(0)
  hra           Float    @default(0)
  allowances    Float    @default(0)
  pf            Float    @default(0)             // employee PF contribution
  esi           Float    @default(0)             // employee ESI contribution
  tds           Float    @default(0)             // monthly TDS
  professionalTax Float  @default(0)
  netSalary     Float    @default(0)
  status        String   @default("active")      // active | inactive | resigned
  joinedAt      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client    Client?   @relation(fields: [clientId], references: [id])
  payrolls  Payroll[]
}

// ─── Payroll (Monthly Salary Runs) ───────────────────────────────────────────────
model Payroll {
  id            String   @id @default(cuid())
  employeeId    String
  period        String                           // YYYY-MM
  grossSalary   Float    @default(0)
  basic         Float    @default(0)
  hra           Float    @default(0)
  allowances    Float    @default(0)
  pf            Float    @default(0)
  esi           Float    @default(0)
  tds           Float    @default(0)
  professionalTax Float  @default(0)
  netSalary     Float    @default(0)
  status        String   @default("generated")   // generated | paid | held
  paidAt        String?
  payslipUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

// ─── Revenue / Cash Flow Forecast ────────────────────────────────────────────────
model RevenueForecast {
  id              String   @id @default(cuid())
  period          String                           // YYYY-MM
  forecastType    String   @default("cash_flow")   // cash_flow | revenue | collection
  projectedInflow Float    @default(0)             // expected collections
  projectedOutflow Float   @default(0)             // expected payments (vendors + payroll + expenses)
  projectedNet    Float    @default(0)             // inflow - outflow
  confidence      Float    @default(0.8)
  factors         String?                          // JSON string of contributing factors
  aiSummary       String?                          // Oracle human-readable summary
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── TDS Liability (Tax Deducted at Source) ──────────────────────────────────────
model TDSRecord {
  id            String   @id @default(cuid())
  clientId      String?
  section       String   @default("194C")         // 194C|194J|194I|194H|94Q|etc
  deducteeName  String
  deducteePan   String?
  paymentAmount Float    @default(0)
  tdsRate       Float    @default(0)
  tdsAmount     Float    @default(0)
  date          String
  status        String   @default("deducted")     // deducted | paid | filed
  quarter       String?                           // Q1|Q2|Q3|Q4
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════════════
// GSTPILOT COMMUNICATION CLOUD™ — Phase 8 Step 4
// Communicate. Remind. Recover. Automate. — The Financial Brain of India™
// WhatsApp + Email + SMS + Notification Center + Collection Recovery +
// Report Distribution + AI Communication Engine
// ═══════════════════════════════════════════════════════════════════════════════

// ─── WhatsApp Business Cloud™ Messages ──────────────────────────────────────────
model WhatsAppMessage {
  id             String    @id @default(cuid())
  clientId       String?
  recipientName  String?
  recipientPhone String                          // E.164 phone number
  templateName   String?                         // WhatsApp template name (if templated)
  messageType    String    @default("text")      // text | template | media | document | interactive
  messageBody    String                          // rendered message text
  mediaUrl       String?                         // attached media/document URL
  caption        String?                         // media caption
  category       String    @default("general")   // invoice | reminder | gst_notice | collection | report | payslip | otp | general
  status         String    @default("queued")    // queued | sent | delivered | read | failed
  errorMessage   String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

// ─── Email Cloud™ Messages ──────────────────────────────────────────────────────
model EmailMessage {
  id            String    @id @default(cuid())
  clientId      String?
  recipientName String?
  recipientEmail String
  templateName  String?
  subject       String
  bodyHtml      String                          // rendered HTML body
  bodyText      String?                         // plain-text fallback
  category      String   @default("general")     // invoice | gst_notice | collection | report | payslip | forecast | general
  attachments   String?                         // JSON string of attachment URLs
  status        String   @default("queued")      // queued | sent | delivered | opened | failed | bounced
  errorMessage  String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  openedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

// ─── SMS Cloud™ Messages ────────────────────────────────────────────────────────
model SMSMessage {
  id            String    @id @default(cuid())
  clientId      String?
  recipientName String?
  recipientPhone String                         // E.164 phone number
  message       String                          // SMS text (max 160 chars per segment)
  category      String   @default("general")     // otp | gst_alert | payment_reminder | due_date | collection | general
  status        String   @default("queued")      // queued | sent | delivered | failed
  errorMessage  String?
  sentAt        DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

// ─── Communication Templates ────────────────────────────────────────────────────
model CommunicationTemplate {
  id            String   @id @default(cuid())
  name          String   @unique                // unique template identifier
  channel       String                          // whatsapp | email | sms
  category      String   @default("general")     // invoice | reminder | gst_notice | collection | report | payslip | otp | general
  subject       String?                         // email subject (email only)
  body          String                          // template body with {{variable}} placeholders
  variables     String?                         // JSON string of variable names + descriptions
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Communication Log (AI Engine audit trail) ──────────────────────────────────
model CommunicationLog {
  id             String   @id @default(cuid())
  clientId       String?
  channel        String                          // whatsapp | email | sms | notification
  eventType      String                          // invoice_due | overdue | payment_received | gst_deadline | escalation | report_delivery | payroll | tds | cash_shortage
  recipient      String                          // phone or email
  recipientName  String?
  templateName   String?
  messagePreview String                          // first 200 chars of rendered message
  status         String   @default("sent")       // sent | delivered | read | failed | escalated
  triggerSource  String   @default("ai_engine")  // ai_engine | manual | scheduled | bulk_campaign
  metadata       String?                         // JSON string of extra context (invoice no, amount, etc.)
  createdAt      DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id])
}

// ═══════════════════════════════════════════════════════════════════════════════
// PHASE 8 STEP 5 — GSTPILOT EXECUTION ENGINE™
// Observe. Think. Decide. Execute. Confirm. Learn.
// 8 models: BusinessEvent, Decision, ExecutionTask, Approval, Workflow,
// UserBehaviour, ExecutionTimeline, AgentMemory
// ═══════════════════════════════════════════════════════════════════════════════

// ─── MODULE 1 — Observation Engine™: BusinessEvent ──────────────────────────────
model BusinessEvent {
  id          String   @id @default(cuid())
  businessId  String?                          // firm/client scope
  type        String                            // gst_due | bank_transaction | receivable | payable | payroll | tds | client_behaviour | cash_flow | collection_risk
  source      String   @default("system")       // system | gst | banking | invoice | communication | payroll | manual
  payload     String?                           // JSON string of event details
  severity    String   @default("info")         // info | low | medium | high | critical
  status      String   @default("open")         // open | acknowledged | resolved | escalated
  createdAt   DateTime @default(now())

  decision    Decision?
}

// ─── MODULE 2 — Decision Engine™: Decision ──────────────────────────────────────
model Decision {
  id          String   @id @default(cuid())
  eventId     String   @unique
  reason      String                            // AI reasoning text
  priority    String   @default("medium")       // low | medium | high | urgent
  action      String                            // action plan: prepare_return | send_reminder | reconcile | delay_payment | forecast | escalate
  status      String   @default("pending")      // pending | approved | rejected | executed | superseded
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       BusinessEvent @relation(fields: [eventId], references: [id])
  tasks       ExecutionTask[]
}

// ─── MODULE 3 — Autonomous Execution Engine™: ExecutionTask ─────────────────────
model ExecutionTask {
  id           String    @id @default(cuid())
  decisionId   String?
  type         String                             // gst_prepare | gst_json | download_2b | bank_reconcile | send_invoice | send_report | send_whatsapp | send_email | send_sms | run_payroll | calc_tds
  description  String
  status       String    @default("queued")       // queued | running | completed | failed | awaiting_approval | cancelled
  startedAt    DateTime?
  completedAt  DateTime?
  result       String?                            // JSON string of execution result
  riskScore    Int       @default(0)              // 0-100; >= threshold needs approval
  agent        String?                            // gst_agent | cfo_agent | collection_agent | compliance_agent | reporting_agent
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  decision     Decision?  @relation(fields: [decisionId], references: [id])
  approval     Approval?
  timeline     ExecutionTimeline[]
}

// ─── MODULE 4 — Approval Engine™: Approval ──────────────────────────────────────
model Approval {
  id          String    @id @default(cuid())
  taskId      String    @unique
  risk        Int                                // 0-100 risk score
  status      String    @default("pending")      // pending | approved | rejected | auto_approved | expired
  reason      String?                            // why approval is needed
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task        ExecutionTask @relation(fields: [taskId], references: [id])
}

// ─── MODULE 5 — Workflow Engine™: Workflow ──────────────────────────────────────
model Workflow {
  id          String   @id @default(cuid())
  name        String                            // Collection Recovery | GST Filing | Cash Crisis | etc.
  type        String                            // collection_recovery | gst_filing | cash_crisis | onboarding | tds_filing | payroll_run
  trigger     String?                           // what event starts this workflow
  steps       String                            // JSON array of {stage, action, agent}
  currentStep Int      @default(0)
  status      String   @default("idle")         // idle | running | paused | completed | aborted
  context     String?                           // JSON string of workflow variables (clientId, amount, etc.)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── MODULE 6 — Learning Engine™: UserBehaviour ────────────────────────────────
model UserBehaviour {
  id          String   @id @default(cuid())
  userId      String?
  action      String                            // approve_filing | reject_reminder | delay_payment | prefer_time | payment_behaviour | filing_pattern
  preference  String                            // learned preference value (e.g. "after_itc_review", "morning_9am")
  confidence  Float    @default(0.5)            // 0.0-1.0 confidence in the learned preference
  evidence    Int      @default(1)              // number of observations supporting this
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ─── MODULE 7 — Execution Timeline™ ─────────────────────────────────────────────
model ExecutionTimeline {
  id          String    @id @default(cuid())
  taskId      String?
  agent       String?                           // gst_agent | cfo_agent | collection_agent | compliance_agent | oracle
  stage       String                            // observe | think | decide | execute | confirm | learn
  title       String                            // "Downloaded GSTR-2B"
  description String?
  timestamp   DateTime @default(now())

  task        ExecutionTask? @relation(fields: [taskId], references: [id])
}

// ─── MODULE 8 — Agent Memory™ ──────────────────────────────────────────────────
model AgentMemory {
  id         String   @id @default(cuid())
  agent      String                            // gst_agent | cfo_agent | collection_agent | compliance_agent | oracle
  memoryType String                            // fact | preference | pattern | outcome | skill
  key        String                            // memory key (e.g. "client_abc_pays_late")
  value      String                            // memory value (JSON or text)
  importance Float    @default(0.5)            // 0.0-1.0 — decays over time if unused
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── PHASE 2 — REAL DATA ENGINE™: Connections & Synced Data ─────────────────────
// User-scoped real data connectors (GSTN, Bank, Gmail, WhatsApp, Tally/Zoho/QB)
// Each connection stores metadata + sync state. Synced raw data is stored per-source.

model DataConnection {
  id            String   @id @default(cuid())
  userId        String                            // Firebase UID
  type          String                            // gstn | bank | gmail | whatsapp | tally | zoho | quickbooks
  status        String   @default("connected")   // connected | disconnected | error | syncing
  label         String                            // "HDFC ****1234" | "GSTN: 27ABCDE1234F1Z5" | "prince@gmail.com"
  identifier    String?                           // GSTIN / account no / email / phone
  metadata      String?                           // JSON: bank name, gstin details, scopes, etc.
  lastSyncAt    DateTime?
  syncInterval  String   @default("15m")          // 15m | 1h | 6h | daily
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  syncedRecords SyncedRecord[]
  qualityAlerts DataQualityAlert[]
}

// Raw synced data from connectors — used by Oracle + Data Quality Engine
model SyncedRecord {
  id            String   @id @default(cuid())
  connectionId  String
  userId        String
  sourceType    String                            // gst_profile | gst_return | bank_tx | email | whatsapp_msg | accounting_invoice | accounting_ledger
  externalId    String?                           // message ID / tx ID / return period — for dedup
  title         String?                           // email subject / tx description / return type
  amount        Float?
  date          String?
  rawData       String?                           // JSON blob of full record
  category      String?                           // gst_notice | vendor_invoice | client_invoice | credit | debit | collection
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  connection    DataConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

// Data Quality Engine — alerts for missing invoices, GST mismatches, duplicates
model DataQualityAlert {
  id            String   @id @default(cuid())
  userId        String
  connectionId  String?
  severity      String   @default("medium")      // low | medium | high | critical
  category      String                            // missing_invoice | gst_mismatch | reconciliation | duplicate | stale_data
  title         String
  description   String?
  amount        Float?
  resolved      Boolean  @default(false)
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  connection    DataConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
}

// ═══════════════════════════════════════════════════════════════════════════════
// GSTPILOT AI CEO™ — AUTONOMOUS BUSINESS OPERATING SYSTEM
// 7 models: CEODecision, CEODailyBrief, CEOAlert, CEOStrategy, CEOTask, CEOGoal, CEOMemory
// Oracle continuously monitors, recommends decisions, plans strategy, creates tasks,
// predicts risks, executes approved workflows — behaving like a world-class CEO.
// ═══════════════════════════════════════════════════════════════════════════════

// ─── CEO MODEL 1 — CEODecision (persists ExecutiveDecision) ─────────────────────
model CEODecision {
  id                  String    @id @default(cuid())
  type                String                              // DecisionType — recover_payment | remind_client | follow_up_lead | increase_prices | reduce_expenses | pause_marketing | increase_marketing | delay_purchase | pay_gst | claim_itc | hire_employees | delay_hiring | suggest_loan | repay_loan | optimize_cash | reduce_vendor_dependency | improve_collections | improve_profitability | improve_runway | review_compliance | review_expense | approve_payroll | renew_subscription | review_contract | pay_vendor | reply_customer | schedule_meeting | file_overdue_return | investigate_anomaly | create_quotation
  title               String
  reason              String
  businessImpact      String
  rollbackPlan        String
  financialImpact     Float
  financialImpactLabel String
  confidence          Float
  priority            String    @default("medium")        // DecisionPriority — critical | high | medium | low
  risk                String    @default("low")            // DecisionRisk — none | low | medium | high | critical
  approvalRequired    String    @default("manager")        // ApprovalRequirement — none | notify | manager | cfo | ceo | board
  requiresRole        String    @default("manager")        // ExecutiveRole — ceo | cfo | manager | employee | auditor
  actions             String                              // JSON string of DecisionAction[]
  evidence            String                              // JSON string of DecisionEvidence[]
  relatedEntityType   String?
  relatedEntityId     String?
  relatedEntityLabel  String?
  status              String    @default("pending")        // DecisionStatus — pending | approved | rejected | executing | executed | failed | superseded | auto_approved
  expiresAt           DateTime?
  executedAt          DateTime?
  executedBy          String?
  approvedBy          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ─── CEO MODEL 2 — CEODailyBrief (1 row per day, cached) ────────────────────────
model CEODailyBrief {
  id          String   @id @default(cuid())
  asOfDay     String   @unique                    // ISO date YYYY-MM-DD
  briefJson   String                              // full DailyCEOBrief JSON
  generatedAt DateTime @default(now())
}

// ─── CEO MODEL 3 — CEOAlert (Executive Alert System) ───────────────────────────
model CEOAlert {
  id                    String    @id @default(cuid())
  type                  String                              // AlertType — cash_shortage | compliance_risk | fraud_suspected | revenue_drop | profit_decline | customer_churn | vendor_risk | payroll_issue | gst_issue | bank_anomaly | collections_problem | inventory_issue | anomaly_detected
  title                 String
  message               String
  severity              String    @default("info")          // AlertSeverity — info | low | medium | high | critical
  detectedAt            DateTime  @default(now())
  relatedEntityType     String?
  relatedEntityId       String?
  suggestedDecisionType String?                             // DecisionType
  acknowledged          Boolean   @default(false)
  acknowledgedBy        String?
  acknowledgedAt        DateTime?
  metadata              String?                             // JSON
}

// ─── CEO MODEL 4 — CEOStrategy (AI Strategy Engine) ────────────────────────────
model CEOStrategy {
  id            String   @id @default(cuid())
  title         String
  description   String
  category      String                              // revenue | expenses | collections | gst | margin | runway | diversification | growth
  objectives    String                              // JSON string[]
  milestones    String                              // JSON StrategyMilestone[]
  kpis          String                              // JSON StrategyKPI[]
  timeline      String
  expectedROI   Float
  expectedROIPct Float
  confidence    Float
  status        String   @default("proposed")       // StrategyStatus — proposed | active | on_track | at_risk | completed | paused
  progressPct   Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── CEO MODEL 5 — CEOTask (Autonomous Task Engine) ────────────────────────────
model CEOTask {
  id                  String    @id @default(cuid())
  type                String                              // TaskType — recover_overdue | file_gst | reply_customer | review_expense | approve_payroll | review_compliance | renew_subscription | review_contract | pay_vendor | follow_up_lead | generate_invoice | send_reminder | schedule_meeting | generate_report | send_proposal | create_quotation | investigate_anomaly
  title               String
  description         String
  businessImpact      String
  aiExplanation       String
  priority            String    @default("medium")        // DecisionPriority — critical | high | medium | low
  deadline            DateTime
  owner               String                              // oracle | gst_agent | collection_agent | compliance_agent | cfo_agent | reporting_agent | user
  status              String    @default("open")          // TaskStatus — open | in_progress | completed | blocked | cancelled
  relatedDecisionId   String?
  relatedEntityType   String?
  relatedEntityId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ─── CEO MODEL 6 — CEOGoal (Business Goals) ────────────────────────────────────
model CEOGoal {
  id           String   @id @default(cuid())
  category     String                              // GoalCategory — revenue | profit | collections | gst_compliance | customer_growth | employee_growth | runway | market_expansion
  title        String
  description  String
  baseline     Float
  current      Float
  target       Float
  unit         String                              // inr | pct | days | count
  deadline     DateTime
  progressPct  Float    @default(0)
  status       String   @default("on_track")       // on_track | at_risk | behind | achieved | overdue
  trendPct     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── CEO MODEL 7 — CEOMemory (CEO Memory) ──────────────────────────────────────
model CEOMemory {
  id           String   @id @default(cuid())
  memoryType   String                              // MemoryType — decision | strategy | milestone | board_meeting | market_change | growth_event | risk_event | learning
  title        String
  description  String
  importance   Float    @default(0.5)
  occurredAt   DateTime @default(now())
  tags         String                              // JSON string[]
  metadata     String?                             // JSON
}

// ═══════════════════════════════════════════════════════════════════════════════
// GSTPILOT AI SOFTWARE FACTORY™ — Production Models
// Self-building software ecosystem: AI dev employees collaborate to design,
// generate, test, deploy, monitor & continuously improve enterprise apps.
// Every record is derived from REAL connected business data.
// ═══════════════════════════════════════════════════════════════════════════════

// ─── SF MODEL 1 — DevProject (software projects) ──────────────────────────────
model DevProject {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String
  appType         String                              // crm | hr | erp | vendor_portal | hospital_mgmt | banking_dashboard | custom
  category        String                              // Finance | HR | Operations | Manufacturing | Retail | Healthcare | Custom
  status          String   @default("planning")       // planning | generating | building | testing | reviewing | deploying | live | failed | archived
  lifecycleStage  String   @default("idea")            // idea | requirements | architecture | design | development | testing | staging | production
  stack           String                              // JSON: { frontend, backend, database, deployment }
  prompt          String                              // original natural-language prompt that created it
  aiEmployees     String                              // JSON string[] of dev-employee IDs that worked on it
  modules         String                              // JSON: generated modules (pages, APIs, tables, workflows, reports)
  spec            String                              // JSON: full generated spec (requirements, architecture, db, api, auth, permissions)
  healthScore     Int      @default(100)              // derived: build pass rate + test coverage + uptime
  coveragePct     Float    @default(0)                // test coverage percentage
  fileCount       Int      @default(0)                // generated file count
  lineCount       Int      @default(0)                // generated lines of code
  version         String   @default("0.1.0")
  repoUrl         String?
  previewUrl      String?
  liveUrl         String?
  businessDataSnapshot String                          // JSON: real business-data snapshot at generation time
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  builds          DevBuild[]
  deployments     DevDeployment[]
  testRuns        DevTestRun[]
  releases        DevRelease[]
  reviews         DevReview[]
  memory          DevMemory[]
  components      DevComponent[]
}

// ─── SF MODEL 2 — DevBuild (build records) ────────────────────────────────────
model DevBuild {
  id           String   @id @default(cuid())
  projectId    String
  project      DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildNumber  Int
  status       String                              // queued | building | success | failed | cancelled
  stage        String                              // install | compile | lint | test | package | upload
  trigger      String                              // manual | ai_employee | webhook | ci | rollback
  triggeredBy  String                              // employee id | user | oracle
  durationMs   Int      @default(0)
  fileSizeMb   Float    @default(0)
  logTail      String                              // last N lines of build log
  errors       Int      @default(0)
  warnings     Int      @default(0)
  artifactUrl  String?
  createdAt    DateTime @default(now())
}

// ─── SF MODEL 3 — DevDeployment (deployment records) ──────────────────────────
model DevDeployment {
  id           String   @id @default(cuid())
  projectId    String
  project      DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment  String                              // development | staging | production | canary | preview
  strategy     String                              // rolling | blue_green | canary | recreate
  status       String                              // pending | deploying | healthy | unhealthy | rolled_back
  buildId      String?
  region       String   @default("ap-south-1")
  url          String?
  replicas     Int      @default(1)
  cpuUsagePct  Float    @default(0)
  memUsageMb   Float    @default(0)
  latencyMs    Float    @default(0)
  errorRatePct Float    @default(0)
  uptimePct    Float    @default(100)
  deployedBy   String                              // employee id | user | oracle | ci
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── SF MODEL 4 — DevTestRun (test runs) ──────────────────────────────────────
model DevTestRun {
  id           String   @id @default(cuid())
  projectId    String
  project      DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildId      String?
  testType     String                              // unit | integration | e2e | performance | load | security | accessibility | regression | visual
  status       String                              // running | passed | failed | skipped
  total        Int      @default(0)
  passed       Int      @default(0)
  failed       Int      @default(0)
  skipped      Int      @default(0)
  durationMs   Int      @default(0)
  coveragePct  Float    @default(0)
  failures     String                              // JSON: array of failing test names + messages
  ranBy        String                              // ai_qa | ci | user
  createdAt    DateTime @default(now())
}

// ─── SF MODEL 5 — DevRelease (release records) ────────────────────────────────
model DevRelease {
  id            String   @id @default(cuid())
  projectId     String
  project       DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version       String
  channel       String                              // development | staging | production | canary
  strategy      String                              // rolling | blue_green | canary | feature_flag
  status        String                              // draft | pending_approval | approved | releasing | released | rolled_back | failed
  featureFlags  String                              // JSON string[]
  releaseNotes  String
  rollbackOf    String?                             // release id this rolls back (if any)
  approvedBy    String?
  releasedBy    String?
  createdAt     DateTime @default(now())
  releasedAt    DateTime?
}

// ─── SF MODEL 6 — DevPipeline (CI/CD pipelines) ───────────────────────────────
model DevPipeline {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  provider     String                              // github | gitlab | azure_devops | docker | kubernetes | vercel | cloudflare | aws | gcp | azure
  stages       String                              // JSON: [{ name, status, durationMs }]
  status       String   @default("idle")           // idle | running | success | failed | cancelled
  lastRunAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── SF MODEL 7 — DevRepository (code repositories) ───────────────────────────
model DevRepository {
  id           String   @id @default(cuid())
  projectId    String?
  name         String
  provider     String                              // github | gitlab | bitbucket | azure_devops
  url          String
  defaultBranch String  @default("main")
  branchCount  Int      @default(1)
  commitCount  Int      @default(0)
  openPRs      Int      @default(0)
  contributors Int      @default(1)
  lastCommitAt DateTime?
  createdAt    DateTime @default(now())
}

// ─── SF MODEL 8 — DevComponent (enterprise component library) ─────────────────
model DevComponent {
  id           String   @id @default(cuid())
  projectId    String?
  project      DevProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  kind         String                              // page | layout | widget | form | report | chart | table | workflow | automation | ai_employee | theme | template | application
  description  String
  category     String
  tags         String                              // JSON string[]
  version      String   @default("1.0.0")
  usageCount   Int      @default(0)
  rating       Float    @default(0)
  isPublished  Boolean  @default(false)
  author       String                              // ai_employee id | user
  spec         String                              // JSON: component definition
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── SF MODEL 9 — DevReview (AI code reviews) ─────────────────────────────────
model DevReview {
  id           String   @id @default(cuid())
  projectId    String
  project      DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewType   String                              // performance | security | architecture | maintainability | accessibility | best_practices | complexity | test_coverage
  reviewer     String                              // ai_security | ai_qa | user | oracle
  status       String   @default("open")           // open | approved | changes_requested | resolved
  score        Float    @default(0)                // 0-100
  findings     String                              // JSON: [{ severity, file, line, message, suggestion }]
  summary      String
  prUrl        String?
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?
}

// ─── SF MODEL 10 — DevMemory (AI Memory — project context that persists) ──────
model DevMemory {
  id           String   @id @default(cuid())
  projectId    String
  project      DevProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  memoryType   String                              // architecture | decision | bug | deployment | feedback | performance | code_evolution | ai_discussion
  title        String
  description  String
  importance   Float    @default(0.5)
  tags         String                              // JSON string[]
  metadata     String?                             // JSON
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════════
// GSTPILOT AUTONOMOUS ENTERPRISE™ — SELF-RUNNING BUSINESS OS
// The World's First Autonomous Enterprise Operating System.
// 9 AI executives collaborate continuously; Oracle plans, decides, executes,
// monitors, learns & continuously improves every business operation from
// REAL connected data. Tagline: Think. Decide. Execute. Learn. Grow.
// ═══════════════════════════════════════════════════════════════════════════════

// ─── AE MODEL 1 — AutonomousStrategyMeeting (AI Strategy Room debates) ────────
model AutonomousStrategyMeeting {
  id              String   @id @default(cuid())
  topic           String                              // agenda of the debate
  trigger         String                              // what triggered the meeting: scheduled | anomaly | decision | goal_review | risk_alert
  opinions        String                              // JSON: ExecutiveOpinion[] (one per exec)
  disagreements   String                              // JSON string[] of recorded disagreements
  consensus       String                              // agreed-upon decision summary
  ceoApproval     String    @default("pending")       // pending | approved | rejected | deferred
  financialImpact Float     @default(0)
  riskLevel       String    @default("low")           // none | low | medium | high | critical
  confidence      Float     @default(0)
  status          String    @default("completed")     // opened | debating | completed | archived
  relatedEntityType String?
  relatedEntityId String?
  transcript      String?                             // optional full transcript
  metadata        String?                             // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── AE MODEL 2 — AutonomousSimulation (Digital Twin Simulator 2.0) ───────────
model AutonomousSimulation {
  id              String   @id @default(cuid())
  scenario        String                              // hire_employees | increase_prices | expand_city | launch_product | acquire_company | open_office | raise_funding | cut_costs | delay_payment | switch_vendor
  title           String
  description     String
  parameters      String                              // JSON: input parameters (e.g. { headcount: 5 })
  baseline        String                              // JSON: current-state snapshot used as control
  predictions     String                              // JSON: SimulationPrediction (revenue/profit/cashFlow/gst/risk/hiring/compliance/roi)
  confidence      Float     @default(0)
  recommendation  String                              // proceed | caution | avoid | needs_review
  status          String    @default("completed")     // queued | running | completed | failed
  approvedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── AE MODEL 3 — AutonomousPlan (Continuous Planning — nightly Oracle plans) ─
model AutonomousPlan {
  id              String   @id @default(cuid())
  horizon         String                              // daily | weekly | monthly | quarterly | yearly
  asOfDate        String                              // ISO date the plan applies to
  title           String
  summary         String
  focusAreas      String                              // JSON string[]
  initiatives     String                              // JSON: PlanInitiative[]
  kpis            String                              // JSON: PlanKPI[]
  risks           String                              // JSON string[]
  department      String?                             // sales | finance | operations | hr | gst | marketing | product | legal | it
  confidence      Float     @default(0)
  generatedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// GSTPILOT ENTERPRISE CLOUD PLATFORM™ — GLOBAL SAAS INFRASTRUCTURE
// Transform GSTPilot Infinity™ from an enterprise application into a globally
// deployable SaaS platform serving thousands of organisations. Oracle™ now
// powers customers. Every organisation gets its own secure enterprise
// (workspace + AI memory + Business Graph + Knowledge Graph + Digital Twin +
// Execution Cloud + Compliance Cloud + Data Intelligence Cloud + Command
// Network + AGI instance). No data leakage between organisations.
// Tagline: Build Once. Deploy Globally. Scale Infinitely.
// ═══════════════════════════════════════════════════════════════════════════════

// ─── ECP MODEL 1 — PlatformOrganization (multi-tenant orgs) ──────────────────
model PlatformOrganization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique                              // URL-safe identifier
  domain          String?                                       // white-label domain
  legalName       String?
  country         String   @default("IN")
  timezone        String   @default("Asia/Kolkata")
  currency        String   @default("INR")
  parentId        String?                                       // parent org (subsidiaries)
  organizationType String  @default("standalone")               // standalone | parent | subsidiary | branch
  plan            String   @default("starter")                  // starter | professional | business | enterprise | enterprise_plus | custom
  planStatus      String   @default("trial")                    // trial | active | past_due | cancelled | suspended
  trialEndsAt     DateTime?
  status          String   @default("active")                   // active | suspended | provisioning | deprovisioned
  industry        String?
  employeeCount   Int      @default(1)
  monthlyRevenue  Float    @default(0)                          // computed MRR for this org
  seatsUsed       Int      @default(1)
  seatsLimit      Int      @default(5)
  storageUsedMb   Float    @default(0)
  storageLimitMb  Float    @default(5120)                       // 5 GB default
  apiCallsMonth   Int      @default(0)
  aiCreditsUsed   Float    @default(0)
  aiCreditsLimit  Float    @default(1000)
  healthScore     Int      @default(80)                         // customer success health
  churnRisk       Float    @default(0)                          // 0-1
  branding        String                                        // JSON: { logoUrl, primaryColor, accentColor, loginHeading, emailFromName }
  settings        String                                        // JSON: feature flags + isolation config
  provisioningState String  @default("provisioned")             // provisioning | provisioned | failed | deprovisioned
  provisionedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  departments     PlatformDepartment[]
  branches        PlatformBranch[]
  costCenters     PlatformCostCenter[]
  tenantUsers     PlatformTenantUser[]
  subscriptions   PlatformSubscription[]
  invoices        PlatformInvoice[]
  apiKeys         PlatformApiKey[]
  installs        PlatformMarketplaceInstall[]
  metrics         PlatformMonitoringMetric[]
  healthRecords   PlatformCustomerHealth[]
  auditEvents     PlatformAuditEvent[]
  environments    PlatformDevopsEnvironment[]
  identityProviders PlatformIdentityProvider[]
  // ─── Enterprise AI Platform™ (Ecosystem) back-relations ───
  extensionInstalls PlatformExtensionInstall[]
  webhookSubscriptions PlatformWebhookSubscription[]
  lowCodeForms     PlatformLowCodeForm[]
  lowCodeWorkflows PlatformLowCodeWorkflow[]
  developers       PlatformDeveloper[]
}

// ─── ECP MODEL 2 — PlatformDepartment (org hierarchy) ────────────────────────
model PlatformDepartment {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  parentId        String?                                       // nested departments
  headUserId      String?
  costCenterId    String?
  headcount       Int      @default(1)
  metadata        String?                                       // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── ECP MODEL 3 — PlatformBranch (geographic branches) ──────────────────────
model PlatformBranch {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  city            String?
  state           String?
  country         String   @default("IN")
  timezone        String   @default("Asia/Kolkata")
  gstin           String?
  isHeadquarters  Boolean  @default(false)
  headcount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── ECP MODEL 4 — PlatformCostCenter ─────────────────────────────────────────
model PlatformCostCenter {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code            String
  name            String
  budget          Float    @default(0)
  spent           Float    @default(0)
  currency        String   @default("INR")
  ownerId         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── ECP MODEL 5 — PlatformTenantUser (org-scoped users) ─────────────────────
model PlatformTenantUser {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email           String
  name            String?
  role            String   @default("member")                   // owner | admin | manager | member | viewer | billing | auditor
  status          String   @default("active")                   // active | invited | suspended | removed
  mfaEnabled      Boolean  @default(false)
  lastActiveAt    DateTime?
  invitedAt       DateTime @default(now())
  joinedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── ECP MODEL 6 — PlatformIdentityProvider (Enterprise Identity Cloud) ──────
model PlatformIdentityProvider {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider        String                                        // email | google | microsoft | github | saml | azure_ad | okta | ldap | passwordless
  label           String
  status          String   @default("configured")               // configured | connected | disabled | error
  config          String                                        // JSON: provider-specific (entityId, ssoUrl, cert, clientId, tenantId, etc.)
  userCount       Int      @default(0)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── ECP MODEL 7 — PlatformSubscription ───────────────────────────────────────
model PlatformSubscription {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan            String                                        // starter | professional | business | enterprise | enterprise_plus | custom
  billingCycle    String   @default("monthly")                  // monthly | annual
  status          String   @default("active")                   // trial | active | past_due | cancelled | paused
  seats           Int      @default(1)
  seatPrice       Float    @default(0)
  monthlyBase     Float    @default(0)
  annualBase      Float    @default(0)
  discountPct     Float    @default(0)
  couponCode      String?
  trialStartsAt   DateTime?
  trialEndsAt     DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt     DateTime?
  metadata        String?                                       // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── ECP MODEL 8 — PlatformInvoice (auto-generated billing invoices) ─────────
model PlatformInvoice {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number          String   @unique
  periodStart     DateTime
  periodEnd       DateTime
  subtotal        Float    @default(0)
  taxPct          Float    @default(18)                         // GST
  taxAmount       Float    @default(0)
  discountAmount  Float    @default(0)
  total           Float    @default(0)
  currency        String   @default("INR")
  status          String   @default("draft")                    // draft | issued | paid | void | overdue | refunded
  lineItems       String                                        // JSON: [{ name, quantity, unitPrice, amount, category }]
  issuedAt        DateTime?
  dueAt           DateTime?
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── ECP MODEL 9 — PlatformApiKey (API Platform — OAuth + API keys) ──────────
model PlatformApiKey {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  keyPrefix       String                                        // visible prefix (e.g. gtp_live_abc12345)
  hashedKey       String                                        // bcrypt hash of full key
  scopes          String                                        // JSON string[] (read | write | admin | billing | agi:execute)
  rateLimitPerMin Int      @default(600)
  rateLimitPerDay Int      @default(100000)
  callsTotal      Int      @default(0)
  callsToday      Int      @default(0)
  lastUsedAt      DateTime?
  expiresAt       DateTime?
  status          String   @default("active")                   // active | revoked | expired
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── ECP MODEL 10 — PlatformMarketplaceInstall ───────────────────────────────
model PlatformMarketplaceInstall {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appId           String                                        // catalog id
  appName         String
  appKind         String                                        // app | agent | workflow | template | dashboard | connector | report | compliance_pack
  publisher       String
  version         String
  status          String   @default("installed")                // installing | installed | failed | uninstalled | update_available
  installedBy     String?
  config          String?                                       // JSON: install config
  rating          Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── ECP MODEL 11 — PlatformMonitoringMetric (Enterprise Monitoring) ────────
model PlatformMonitoringMetric {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bucket          String                                        // YYYY-MM-DDTHH:00
  metric          String                                        // api_calls | agi_executions | errors | uptime_ms | latency_ms | storage_mb | ai_tokens | active_users | workflow_runs
  value           Float    @default(0)
  unit            String   @default("count")
  createdAt       DateTime @default(now())
}

// ─── ECP MODEL 12 — PlatformCustomerHealth (Customer Success Center) ─────────
model PlatformCustomerHealth {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  score           Int      @default(80)                         // 0-100
  adoptionPct     Float    @default(0)
  featureUsage    String                                        // JSON: { feature -> usagePct }
  churnRisk       Float    @default(0)                          // 0-1
  expansionScore  Float    @default(0)                          // 0-1
  openTickets     Int      @default(0)
  satisfaction    Float    @default(0)                          // CSAT 0-5
  lastContactAt   DateTime?
  recommendedActions String                                     // JSON string[]
  computedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
}

// ─── ECP MODEL 13 — PlatformAuditEvent (Security audit log) ──────────────────
model PlatformAuditEvent {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor           String                                        // user email | system | oracle
  action          String                                        // user.invite | role.change | billing.subscribe | api.key.create | data.export | etc.
  category        String                                        // auth | billing | security | data | config | api | admin
  targetType      String?
  targetId        String?
  severity        String   @default("info")                     // info | warn | critical
  ipAddress       String?
  userAgent       String?
  details         String                                        // JSON
  createdAt       DateTime @default(now())
}

// ─── ECP MODEL 14 — PlatformDevopsEnvironment (DevOps Cloud) ─────────────────
model PlatformDevopsEnvironment {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String                                        // production | staging | development | sandbox | preview
  environmentType String
  region          String   @default("ap-south-1")
  version         String?
  status          String   @default("healthy")                  // provisioning | healthy | deploying | unhealthy | rolled_back
  strategy        String   @default("rolling")                  // rolling | blue_green | canary | recreate
  replicas        Int      @default(1)
  uptimePct       Float    @default(100)
  latencyMs       Float    @default(0)
  errorRatePct    Float    @default(0)
  cpuUsagePct     Float    @default(0)
  memUsageMb      Float    @default(0)
  lastDeployAt    DateTime?
  lastDeployBy    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENTERPRISE AI PLATFORM™ (ECOSYSTEM EDITION) — DEVELOPER PLATFORM MODELS
// Turns GSTPilot into a platform developers & partners can build on:
// extensions/apps, webhooks, low-code studio, api-gateway usage, developers.
// ═══════════════════════════════════════════════════════════════════════════════

// ─── EAP MODEL 1 — PlatformExtension (marketplace + private app registry) ───
model PlatformExtension {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  displayName     String
  description     String
  publisher       String                                          // developer handle / org name
  developerId     String?
  kind            String                                          // app | agent | workflow | dashboard | connector | template | report | compliance_pack | plugin
  category        String                                          // hr | banking | crm | manufacturing | retail | logistics | healthcare | legal | tax | ai
  version         String
  visibility      String   @default("public")                     // public | private
  pricingModel    String   @default("free")                       // free | one_time | subscription | usage_based
  priceInr        Float    @default(0)
  status          String   @default("published")                  // draft | in_review | published | suspended | deprecated
  manifest        String                                          // JSON: permissions, entrypoints, config schema
  iconUrl         String?
  screenshots     String?                                         // JSON string[]
  installCount    Int      @default(0)
  ratingAvg       Float    @default(0)
  ratingCount     Int      @default(0)
  reviews         PlatformExtensionReview[]
  installs        PlatformExtensionInstall[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── EAP MODEL 2 — PlatformExtensionInstall (per-org install record) ────────
model PlatformExtensionInstall {
  id              String   @id @default(cuid())
  extensionId     String
  extension       PlatformExtension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  version         String
  status          String   @default("installed")                  // installing | installed | disabled | update_available | uninstalled
  permissions     String?                                         // JSON: granted permission scope list
  config          String?                                         // JSON: install-time config
  installedBy     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([extensionId, organizationId])
}

// ─── EAP MODEL 3 — PlatformExtensionReview (ratings + reviews) ──────────────
model PlatformExtensionReview {
  id              String   @id @default(cuid())
  extensionId     String
  extension       PlatformExtension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  organizationId  String
  authorEmail     String
  authorName      String
  rating          Int                                             // 1..5
  title           String
  body            String
  helpfulCount    Int      @default(0)
  createdAt       DateTime @default(now())
}

// ─── EAP MODEL 4 — PlatformWebhookSubscription (event delivery config) ──────
model PlatformWebhookSubscription {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label           String
  targetUrl       String
  eventTypes      String                                          // JSON string[] — event type filters; ["*"] = all
  secret          String?                                         // HMAC signing secret
  status          String   @default("active")                     // active | paused | failing | deleted
  deliveries      Int      @default(0)
  successCount    Int      @default(0)
  failureCount    Int      @default(0)
  lastDeliveryAt  DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── EAP MODEL 5 — PlatformWebhookDelivery (delivery attempt log) ───────────
model PlatformWebhookDelivery {
  id              String   @id @default(cuid())
  subscriptionId  String
  eventType       String                                          // invoice.created | payment.received | gst.filed | lead.won | etc.
  payload         String                                          // JSON event body
  statusCode      Int?
  responseMs      Int?
  attempt         Int      @default(1)
  status          String   @default("pending")                    // pending | success | failed | retrying
  error           String?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
}

// ─── EAP MODEL 6 — PlatformApiUsageLog (observability + rate-limit counters) ─
model PlatformApiUsageLog {
  id              String   @id @default(cuid())
  organizationId  String?
  apiKeyId        String?
  endpoint        String                                          // e.g. /api/oracle/ask
  method          String                                          // GET | POST | ...
  statusCode      Int
  responseMs      Int
  userAgent       String?
  ipAddress       String?
  tokensConsumed  Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([apiKeyId, createdAt])
  @@index([organizationId, createdAt])
}

// ─── EAP MODEL 7 — PlatformLowCodeForm (user-built forms) ───────────────────
model PlatformLowCodeForm {
  id              String   @id @default(cuid())
  organizationId  String
  organization    PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug            String
  title           String
  description     String?
  schema          String                                          // JSON: field definitions
  status          String   @default("active")                     // active | archived
  submissionsCount Int     @default(0)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, slug])
}

// ─── EAP MODEL 8 — PlatformLowCodeSubmission (form submission records) ──────
model PlatformLowCodeSubmission {
  id              String   @id @default(cuid())
  formId          String
  data            String                                          // JSON: submitted values
  submitterEmail  String?
  submitterIp     String?
  createdAt       DateTime @default(now())
}

// ─── EAP MODEL 9 — PlatformLowCodeWorkflow (user-built automations) ─────────
model PlatformLowCodeWorkflow {
