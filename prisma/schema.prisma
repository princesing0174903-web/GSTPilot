generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("staff")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id             String   @id @default(cuid())
  gstin          String   @unique
  tradeName      String
  legalName      String?
  address        String?
  state          String?
  stateCode      String?
  contactEmail   String?
  contactPhone   String?
  entityType     String   @default("regular")
  returnPeriod   String?
  lastFilingDate String?
  status         String   @default("active")
  healthScore    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices            Invoice[]
  gstrFilings         GSTRFiling[]
  healthScores        HealthScore[]
  issues              Issue[]
  auditLogs           AuditLog[]
  notices             Notice[]
  documents           Document[]
  riskScores          RiskScore[]
  complianceForecasts ComplianceForecast[]
  clientInsights      ClientInsight[]
  benchmarks          ClientBenchmark[]
}

model Invoice {
  id            String   @id @default(cuid())
  clientId      String
  invoiceNumber String
  invoiceDate   String
  sellerGstin   String
  buyerGstin    String?
  buyerName     String?
  invoiceType   String   @default("B2B")
  gstr1Section  String   @default("b2b")
  taxableValue  Float    @default(0)
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  igst          Float    @default(0)
  cess          Float    @default(0)
  totalAmount   Float    @default(0)
  hsnCode       String?
  reverseCharge Boolean  @default(false)
  status        String   @default("draft")
  matchStatus   String   @default("unmatched")
  riskLevel     String   @default("low")
  riskScore     Int      @default(0)
  aiExplanation String?
  notes         String?
  period        String?
  assignedTo    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client          Client                 @relation(fields: [clientId], references: [id])
  reconciliations ReconciliationResult[]
  issues          Issue[]
}

model GSTRFiling {
  id                   String   @id @default(cuid())
  clientId             String
  returnType           String   @default("GSTR-1")
  period               String
  financialYear        String?
  status               String   @default("draft")
  filedDate            String?
  acknowledgmentNumber String?
  totalInvoices        Int      @default(0)
  readyForFiling       Int      @default(0)
  issuesFound          Int      @default(0)
  criticalErrors       Int      @default(0)
  warnings             Int      @default(0)
  totalTaxableValue    Float    @default(0)
  totalTax             Float    @default(0)
  jsonPayload          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  client Client        @relation(fields: [clientId], references: [id])
  events FilingEvent[]
  issues Issue[]
}

model ReconciliationResult {
  id               String   @id @default(cuid())
  clientId         String
  invoiceId        String
  sourceType       String   @default("books")
  sourceA          String?  @default("Purchase Register")
  sourceB          String?  @default("GSTR-2B")
  sourceGstin      String?
  matchedGstin     String?
  matchStatus      String   @default("unmatched")
  matchScore       Float    @default(0)
  mismatches       String?
  aiExplanation    String?
  aiRecommendation String?
  confidenceScore  Float    @default(0)
  workflowStatus   String   @default("pending")
  resolved         Boolean  @default(false)
  resolvedBy       String?
  resolvedAt       String?
  riskLevel        String   @default("low")
  runId            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoice Invoice            @relation(fields: [invoiceId], references: [id])
  run     ReconciliationRun? @relation(fields: [runId], references: [id])
}

model ReconciliationRun {
  id             String   @id @default(cuid())
  clientId       String
  period         String
  sources        String   @default("Purchase Register,GSTR-2B")
  totalRecords   Int      @default(0)
  matched        Int      @default(0)
  unmatched      Int      @default(0)
  partialMatches Int      @default(0)
  highRisk       Int      @default(0)
  gstDifference  Float    @default(0)
  status         String   @default("completed")
  runBy          String?
  createdAt      DateTime @default(now())

  results ReconciliationResult[]
}

model FilingEvent {
  id          String   @id @default(cuid())
  filingId    String
  clientId    String
  eventType   String
  description String?
  userId      String?
  timestamp   DateTime @default(now())

  filing GSTRFiling @relation(fields: [filingId], references: [id])
}

model Issue {
  id          String   @id @default(cuid())
  clientId    String
  invoiceId   String?
  filingId    String?
  severity    String   @default("info")
  category    String
  title       String
  description String?
  status      String   @default("open")
  assignedTo  String?
  notes       String?
  resolvedAt  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client  Client      @relation(fields: [clientId], references: [id])
  invoice Invoice?    @relation(fields: [invoiceId], references: [id])
  filing  GSTRFiling? @relation(fields: [filingId], references: [id])
}

model HealthScore {
  id                String   @id @default(cuid())
  clientId          String
  score             Int      @default(0)
  missingGstin      Int      @default(0)
  invalidGstin      Int      @default(0)
  duplicateInvoices Int      @default(0)
  filingDelays      Int      @default(0)
  validationErrors  Int      @default(0)
  period            String?
  createdAt         DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  clientId  String?
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  timestamp DateTime @default(now())

  client Client? @relation(fields: [clientId], references: [id])
}

// ─── CA Firm Operations Layer ───

model TeamMember {
  id         String   @id @default(cuid())
  userId     String?  @unique
  name       String
  email      String   @unique
  role       String   @default("staff")
  department String?  @default("general")
  avatar     String?
  isActive   Boolean  @default(true)
  joinedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  performances TeamPerformance[]
  assignments  WorkloadAssignment[]
  notices      Notice[]
}

model TeamPerformance {
  id                 String   @id @default(cuid())
  teamMemberId       String
  period             String
  invoicesProcessed  Int      @default(0)
  reviewsCompleted   Int      @default(0)
  approvalsCompleted Int      @default(0)
  averageAccuracy    Float    @default(0)
  averageTurnaround  Float    @default(0)
  totalActions       Int      @default(0)
  score              Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id])
}

model WorkloadAssignment {
  id           String    @id @default(cuid())
  teamMemberId String
  entityType   String    @default("invoice")
  entityId     String?
  clientId     String?
  title        String
  description  String?
  status       String    @default("pending")
  priority     String    @default("medium")
  dueDate      String?
  assignedBy   String?
  assignedAt   DateTime  @default(now())
  completedAt  DateTime?
  notes        String?

  teamMember TeamMember @relation(fields: [teamMemberId], references: [id])
}

model Notice {
  id           String   @id @default(cuid())
  clientId     String
  noticeType   String   @default("gst_notice")
  noticeNumber String?
  noticeDate   String?
  subject      String
  description  String?
  status       String   @default("open")
  assignedTo   String?
  priority     String   @default("medium")
  dueDate      String?
  responseDate String?
  resolution   String?
  attachments  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client   Client      @relation(fields: [clientId], references: [id])
  assignee TeamMember? @relation(fields: [assignedTo], references: [id])
}

model Document {
  id          String   @id @default(cuid())
  clientId    String?
  folder      String   @default("general")
  name        String
  fileType    String   @default("pdf")
  size        Int      @default(0)
  path        String?
  tags        String?
  description String?
  uploadedBy  String?
  version     Int      @default(1)
  isLatest    Boolean  @default(true)
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client   Client?    @relation(fields: [clientId], references: [id])
  parent   Document?  @relation("DocumentVersion", fields: [parentId], references: [id])
  versions Document[] @relation("DocumentVersion")
}

model AutomationRule {
  id          String    @id @default(cuid())
  name        String
  description String?
  trigger     String
  conditions  String?
  actions     String
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  runCount    Int       @default(0)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs AutomationLog[]
}

model AutomationLog {
  id         String   @id @default(cuid())
  ruleId     String
  trigger    String
  status     String   @default("success")
  details    String?
  executedAt DateTime @default(now())

  rule AutomationRule @relation(fields: [ruleId], references: [id])
}

model FirmSettings {
  id            String   @id @default(cuid())
  firmName      String   @default("GSTPilot Firm")
  logoUrl       String?
  primaryColor  String   @default("#059669")
  accentColor   String   @default("#7c3aed")
  customDomain  String?
  emailFromName String?
  emailTemplate String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FirmMetrics {
  id                String   @id @default(cuid())
  period            String   @unique
  totalRevenue      Float    @default(0)
  mrr               Float    @default(0)
  arr               Float    @default(0)
  clientsOnboarded  Int      @default(0)
  activeClients     Int      @default(0)
  inactiveClients   Int      @default(0)
  teamUtilization   Float    @default(0)
  avgProcessingTime Float    @default(0)
  avgFilingTime     Float    @default(0)
  gstProcessed      Float    @default(0)
  profitability     Float    @default(0)
  clientGrowth      Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ─── AI Tax Intelligence Layer ───

model AIPrediction {
  id             String   @id @default(cuid())
  category       String   @default("revenue")
  period         String
  predictedValue Float    @default(0)
  confidence     Float    @default(0)
  lowerBound     Float    @default(0)
  upperBound     Float    @default(0)
  trend          String   @default("stable")
  modelVersion   String   @default("v1")
  factors        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RiskScore {
  id              String   @id @default(cuid())
  clientId        String
  overallScore    Int      @default(0)
  category        String   @default("overall")
  lateFilings     Int      @default(0)
  noticeFrequency Int      @default(0)
  gstMismatches   Int      @default(0)
  vendorRisk      Float    @default(0)
  itcRisk         Float    @default(0)
  riskLevel       String   @default("low")
  period          String
  factors         String?
  recommendations String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
}

model ComplianceForecast {
  id                String   @id @default(cuid())
  clientId          String?
  forecastType      String   @default("notice")
  predictedEvent    String
  probability       Float    @default(0)
  confidence        Float    @default(0)
  expectedDate      String?
  impact            String   @default("medium")
  mitigatingActions String?
  period            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

model ClientInsight {
  id          String   @id @default(cuid())
  clientId    String
  category    String   @default("compliance")
  trend       String   @default("stable")
  observation String
  confidence  Float    @default(0)
  dataPoints  String?
  period      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
}

model AITask {
  id           String    @id @default(cuid())
  clientId     String?
  source       String    @default("ai")
  sourceType   String    @default("notice")
  sourceId     String?
  title        String
  description  String?
  priority     String    @default("medium")
  status       String    @default("pending")
  assignedTo   String?
  dueDate      String?
  autoAssigned Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model KnowledgeEntry {
  id              String   @id @default(cuid())
  title           String
  category        String   @default("rule")
  content         String
  summary         String?
  tags            String?
  source          String?
  effectiveDate   String?
  referenceNumber String?
  relevanceScore  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DocumentChatSession {
  id         String   @id @default(cuid())
  documentId String?
  fileName   String?
  fileType   String?
  messages   String   @default("[]")
  summary    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ExecutiveReport {
  id          String   @id @default(cuid())
  reportType  String   @default("client_health")
  title       String
  description String?
  period      String
  data        String?
  format      String   @default("pdf")
  status      String   @default("generated")
  generatedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClientBenchmark {
  id                 String   @id @default(cuid())
  clientId           String
  metric             String
  clientValue        Float    @default(0)
  industryAverage    Float    @default(0)
  stateAverage       Float    @default(0)
  firmAverage        Float    @default(0)
  industryPercentile Float    @default(0)
  statePercentile    Float    @default(0)
  firmPercentile     Float    @default(0)
  period             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id])
}
