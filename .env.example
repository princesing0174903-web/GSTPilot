# ═══════════════════════════════════════════════════════════════════════════════
# GSTPilot Infinity™ — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy to `.env` (development) or configure in your hosting provider's dashboard
# (production). NEVER commit real secrets to git.
#
# Required for the app to boot: DATABASE_URL, NEXTAUTH_SECRET / CSRF_SECRET.
# Everything else is optional — modules that lack credentials show a clean
# "not configured" state instead of crashing.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Core (REQUIRED) ──────────────────────────────────────────────────────────
# SQLite (dev) — "file:./db/custom.db"  |  PostgreSQL (prod) — "postgresql://user:pass@host:5432/db?schema=public"
DATABASE_URL="file:./db/custom.db"

# Secret used to sign session cookies / CSRF tokens. Generate with: openssl rand -hex 32
CSRF_SECRET=""
# NEXTAUTH_SECRET=""  # if using NextAuth

# Public app URL — the origin users hit in the browser. Used for OAuth redirect
# URIs, OG tags, and absolute link generation. NO trailing slash.
# Dev: http://localhost:3000  |  Prod: https://app.yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── AI / LLM Provider (z-ai-web-dev-sdk is the default; others optional) ─────
AI_PROVIDER="zai"                    # zai | openai | anthropic | gemini | google | custom
ZAI_API_KEY=""
ZAI_MODEL=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
GEMINI_MODEL=""
GOOGLE_AI_API_KEY=""
CUSTOM_AI_API_KEY=""
ELEVENLABS_API_KEY=""               # TTS
RUNWAY_API_KEY=""                   # video generation
STABILITY_API_KEY=""                # image generation
AI_ENCRYPTION_KEY=""                # encrypts stored AI provider credentials

# ─── Authentication (Firebase) ───────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""             # full PEM including \n escapes

# ─── Google Workspace OAuth (Gmail, Drive, Sheets, Calendar) ──────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Add the production redirect URI to Authorized redirect URIs:
#   https://app.yourdomain.com/api/integrations/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""              # leave blank to auto-derive from request origin

# ─── Zoho Books OAuth ─────────────────────────────────────────────────────────
# Create a Server-based app at https://api-console.zoho.com
# Add redirect URI: https://app.yourdomain.com/api/integrations/zoho/callback
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_DC="in"                        # in | eu | us | au | jp | ca | sa | gb
ZOHO_ACCOUNTS_URL=""                # leave blank to auto-derive from ZOHO_DC
ZOHO_BOOKS_API=""                   # leave blank to auto-derive from ZOHO_DC
ZOHO_REDIRECT_URI=""                # leave blank to auto-derive from request origin
ZOHO_REDIRECT_URI_DYNAMIC="true"   # derive redirect URI from request origin
ZOHO_OAUTH_STATE_SECRET=""          # generate with openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=""       # encrypts stored Zoho tokens

# ─── Setu Banking (Account Aggregator) — SANDBOX first ───────────────────────
# Get sandbox credentials at https://docs.setu.co/data/aa
SETU_CLIENT_ID=""
SETU_CLIENT_SECRET=""
SETU_PRODUCT_INSTANCE_ID=""
SETU_BASE_URL="https://sandbox.setu.co"  # sandbox | https://aa.setu.co for prod
SETU_AUTH_URL="https://sandbox.setu.co/token"
SETU_REDIRECT_URL=""                # https://app.yourdomain.com/banking/consent/return
SETU_WEBHOOK_SECRET=""
SETU_TIMEOUT_MS="30000"
SETU_MAX_RETRIES="3"
SETU_LOG_LEVEL="info"
BANK_ENCRYPTION_KEY=""              # encrypts stored bank credentials
BANK_PROVIDER="setu"                # setu | mock (mock = in-memory, NEVER use in prod)
BANKING_PROVIDER="setu"

# ─── GSTN / MastersIndia GSP (PROVIDE OFFICIAL SANDBOX CREDENTIALS) ──────────
# Do NOT use sample/documentation credentials. Obtain official sandbox creds
# from MastersIndia (https://mastersindia.co) or your chosen GSP.
GSTN_PROVIDER="mastersindia"        # mastersindia | mock (mock = NOT_TESTED state)
GSTN_API_BASE_URL=""                # sandbox endpoint
GSTN_AUTH_BASE_URL=""
GSTN_CLIENT_ID=""
GSTN_CLIENT_SECRET=""
GSTN_GSP_BASE_URL=""
GSTN_GSP_CLIENT_ID=""
GSTN_GSP_CLIENT_SECRET=""
GSTN_GSP_CODE=""
GSTN_ENCRYPTION_KEY=""              # encrypts stored GSTN tokens

# ─── ERP Connectors (Tally / Busy / Zoho Books / QuickBooks) ──────────────────
ERP_PROVIDER=""                     # tally | busy | zoho-books | quickbooks | mock
ERP_ENCRYPTION_KEY=""
MOCK_ERP_PROVIDER=""                # "true" to force mock in dev

# ─── Communication (Gmail / WhatsApp) ────────────────────────────────────────
COMMUNICATION_GMAIL_PROVIDER="google-oauth"  # google-oauth | mock
COMMUNICATION_WHATSAPP_PROVIDER=""            # meta | twilio | mock
WHATSAPP_APP_SECRET=""
COMMUNICATION_ENCRYPTION_KEY=""

# ─── Billing (Razorpay / Stripe) ──────────────────────────────────────────────
PAYMENT_PROVIDER=""                 # razorpay | stripe | mock
BILLING_ENCRYPTION_KEY=""

# ─── Oracle AI / Encryption ──────────────────────────────────────────────────
ORACLE_ENCRYPTION_KEY=""

# ─── Admin / Superusers ───────────────────────────────────────────────────────
ADMIN_TOKEN=""                      # protects /api/admin/* routes
SUPER_ADMIN_EMAILS=""               # comma-separated allowlist

# ─── Seeding (DEV ONLY — leave blank in production) ───────────────────────────
# When "true", the app seeds demo customers/invoices/banking. NEVER enable in
# production — would create demo records in the live database.
GSTPILOT_ALLOW_SEED=""

# ─── Supabase (optional alternative storage) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ─── Optional: firm context for single-tenant deploys ─────────────────────────
NEXT_PUBLIC_FIRM_ID=""
